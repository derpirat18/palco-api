# Copiar a .env y ajustar. NUNCA subir .env al repositorio.
ENTORNO=local
DEBUG=true

DATABASE_URL=postgresql://palco:palco@localhost:5432/palco_dev
REDIS_URL=redis://localhost:6379/0

# Obligatorias y distintas entre si. La app no arranca con estos valores.
# Generar cada una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# SECRET_KEY firma los tokens de sesion del personal.
# TICKET_SIGNING_KEY firma el QR de los boletos: rotarla invalida todos
# los boletos ya emitidos, asi que se fija una vez por temporada.
SECRET_KEY=cambiame_por_una_llave_larga_y_aleatoria_de_al_menos_32
TICKET_SIGNING_KEY=cambiame_tambien_por_otra_distinta_de_al_menos_32

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

CORS_ORIGINS=["http://localhost:5173"]

# Base de los enlaces de los correos ("Ver mis boletos").
FRONT_URL=http://localhost:5173

# Correo. En local van al buzon de pruebas: docker compose up -d mailpit
# y se ven en http://localhost:8025. En produccion: Amazon SES por SMTP,
# puerto 587, STARTTLS y el usuario SMTP que genera la consola de SES.
CORREO_SMTP_HOST=localhost
CORREO_SMTP_PUERTO=1025
CORREO_SMTP_USUARIO=
CORREO_SMTP_PASSWORD=
CORREO_SMTP_STARTTLS=false
CORREO_REMITENTE=Palco <boletos@palco.local>

# Limites contra bots y fuerza bruta (ADR 0016). Fuera de local siempre
# encendidos. PROXIES_DE_CONFIANZA: cuantos proxies propios hay delante
# de la API (1 con el balanceador de AWS); con 0 se ignora X-Forwarded-For.
LIMITES_ACTIVOS=true
PROXIES_DE_CONFIANZA=0

# Sala de espera (ADR 0017). Apagada hasta que la sala este lista.
SALA_DE_ESPERA_HABILITADA=false
