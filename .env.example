# Copiar a .env y ajustar. NUNCA subir .env al repositorio.
ENTORNO=local
DEBUG=true

DATABASE_URL=postgresql://palco:palco@localhost:5432/palco_dev
REDIS_URL=redis://localhost:6379/0

# Obligatorias y distintas entre si. La app no arranca con estos valores.
# Generar cada una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# SECRET_KEY firma los tokens de sesion del personal.
# TICKET_SIGNING_KEY firma el QR de los boletos: rotarla invalida todos
# los boletos ya emitidos, asi que se fija una vez por temporada.
SECRET_KEY=cambiame_por_una_llave_larga_y_aleatoria_de_al_menos_32
TICKET_SIGNING_KEY=cambiame_tambien_por_otra_distinta_de_al_menos_32

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

CORS_ORIGINS=["http://localhost:5173"]
